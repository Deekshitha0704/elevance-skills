# Generate independent random values with at least 32 characters; never commit real secrets.
SESSION_SECRET=replace-with-a-random-session-signing-secret-of-at-least-32-characters
OTP_HASH_SECRET=replace-with-a-different-random-otp-hashing-secret-of-at-least-32-characters

# Resend email delivery, used for French-language OTPs and payment receipts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio SMS delivery, used for English, Spanish, Hindi, Portuguese, and Chinese OTPs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Razorpay payment gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
